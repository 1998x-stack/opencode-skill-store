# Set these in the OpenCode Server process environment. Never commit real values.
SKILL_STORE_BASE_URL=https://skill-store.internal
SKILL_STORE_API_KEY=
SKILL_STORE_API_KEY_HEADER=Authorization
SKILL_STORE_API_KEY_PREFIX=Bearer 
OPENCODE_SKILL_STORE_DIR=~/.opencode/skill-store

# Candidate default paths; verify against the actual Go Store router/OpenAPI.
SKILL_STORE_ASSETS_PATH=/v1/asset-store/assets
SKILL_STORE_ASSET_DETAIL_PATH=/v1/asset-store/assets/{id}
SKILL_STORE_PACKAGE_CONTENT_PATH=/v1/asset-store/packages/{id}/content

SKILL_STORE_MAX_PACKAGE_BYTES=104857600
SKILL_STORE_MAX_UNPACKED_BYTES=314572800
SKILL_STORE_MAX_ENTRIES=2000
SKILL_STORE_MAX_COMPRESSION_RATIO=100
